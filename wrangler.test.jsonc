// Test-only Worker config for @cloudflare/vitest-pool-workers.
//
// Identical to wrangler.jsonc except it drops two bindings that force the pool
// into a *remote* proxy session -- which needs CLOUDFLARE_API_TOKEN and so
// fails in CI:
//   - "ai": Workers AI has no local emulation.
//   - "send_email": no local emulation.
// No test exercises either: chat tests pass a mocked env.AI, and the
// /auth/email/start tests only hit the 400/405 branches before any send.
// KV, assets, vars and rate limits are all emulated locally by miniflare, and
// the suite is written to run with no secrets (it asserts the 503
// "not configured" responses).
{
  "name": "studystacks",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "MAGIC_LINKS", "id": "743b3e7249f649879ee90558c52bc7f5" },
    { "binding": "GUIDE_REQUESTS", "id": "05ee5b68b6894ab5866ccc2a003ce0de" },
    { "binding": "PROGRESS", "id": "be732bc294cf4708a74f05e375223b4e" }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "740897161648-4r7kdvrp9pkr8lloqbc6php60qnnbo38.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23litIZA8irIufEaOA",
    "ADMIN_EMAILS": "tvsmiley833@gmail.com",
    "VAPID_PUBLIC_KEY": "BFLqJyuV9vTCmo9TTgfsX9yOgI1DhUopA1Bm7Kw-Raxt5aD9286kiIVFLPcCWuInwcNzsTIuuAX-439U_D2WH1Q"
  },
  "ratelimits": [
    { "name": "CHAT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
