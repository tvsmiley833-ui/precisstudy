{
  "name": "precisstudy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "dev:login": "wrangler dev --local-upstream localhost:8787 --env-file .dev-login.vars",
    "deploy": "wrangler deploy",
    "test": "npm run test:scripts && vitest run",
    "test:scripts": "node --test test/*.node.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:client": "esbuild client/personality.js --minify --format=esm --target=es2022 --legal-comments=none --tsconfig-raw={} --outfile=public/shared/personality.js && esbuild client/guide-app.js --minify --target=es2020 --legal-comments=none --tsconfig-raw={} --outfile=public/shared/guide-app.js",
    "predeploy": "node scripts/generate-tips.mjs && node scripts/gen-lastmod.mjs && npm run build:client && npm run typecheck && npm test",
    "postdeploy": "node scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "guides:regen": "node scripts/regen-guides.mjs && node scripts/gen-class-counts.mjs",
    "tips:gen": "node scripts/generate-tips.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260811.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2"
  }
}
