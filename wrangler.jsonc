{
  "name": "studystacks",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "studystacks.org", "custom_domain": true },
    { "pattern": "www.studystacks.org", "custom_domain": true }
  ]
}
