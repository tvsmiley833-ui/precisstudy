{
  "name": "studystacks",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    { "binding": "MAGIC_LINKS", "id": "743b3e7249f649879ee90558c52bc7f5" }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "740897161648-4r7kdvrp9pkr8lloqbc6php60qnnbo38.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "0v23litIZA8irIufEa0A"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "studystacks.org", "custom_domain": true },
    { "pattern": "www.studystacks.org", "custom_domain": true }
  ]
}
